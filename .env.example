# Copy this file to `.env` for local use. Never commit a real key.
# OPENAI_API_KEY is optional: leave it empty for deterministic prepared-data mode.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-luna when blank or omitted.
OPENAI_MODEL=gpt-5.6-luna

# Optional integer from 1 to 100. This is a best-effort browser-session allowance.
FINALFLOW_MAX_AI_REQUESTS_PER_SESSION=10

# Optional local/CI safety switch. true/1/yes/on disables all OpenAI calls.
FINALFLOW_DISABLE_OPENAI=false

# Optional server-only search credential. Never expose it to browser code.
SERPAPI_API_KEY=
# true/1/yes/on disables search; project questions never require web search.
FINALFLOW_DISABLE_SEARCH=false
